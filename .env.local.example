# Supabase credentials — copy this file to .env.local and fill in the values.
# .env.local is gitignored by Create React App so secrets stay local.
#
# Get these from: Supabase Dashboard -> Settings -> API
#   - REACT_APP_SUPABASE_URL:      Project URL (e.g. https://xxxxx.supabase.co)
#   - REACT_APP_SUPABASE_ANON_KEY: anon / public key (the long JWT)
#
# DO NOT put the service_role key in this file. That key bypasses Row-Level
# Security and must never leave a server-side environment.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
